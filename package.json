{
  "name": "@peanut-admin/web-workspace",
  "version": "4.0.0-dev.1",
  "private": true,
  "description": "Peanut Admin reusable web client, framework adapters, UI, and test tooling",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {"node": ">=22.12.0 <23"},
  "devDependencies": {
    "@vue/test-utils": "2.4.11",
    "element-plus": "2.14.3",
    "happy-dom": "20.10.6",
    "pinia": "4.0.2",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "vue": "3.5.39",
    "vue-router": "5.2.0"
  },
  "scripts": {
    "build": "pnpm --recursive --workspace-concurrency=1 run build",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 run typecheck",
    "test": "pnpm run build && vitest run",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "pack:candidates": "pnpm --recursive --workspace-concurrency=1 run pack:candidate",
    "verify:a1": "node scripts/verify-a1-packages.mjs"
  }
}
