{
  "name": "@peanut-admin/nuxt",
  "version": "5.0.0",
  "description": "Nuxt transport adapter for Peanut Admin",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peanut-business/peanut-admin-core-web.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:candidate": "pnpm pack --pack-destination ../../artifacts"
  },
  "peerDependencies": {
    "@peanut-admin/client": "5.0.0"
  },
  "devDependencies": {
    "@peanut-admin/client": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
