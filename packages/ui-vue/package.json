{
  "name": "@peanut-admin/ui-vue",
  "version": "5.0.2",
  "description": "Reusable Vue UI components for Peanut Admin",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peanut-business/peanut-admin-core-web.git",
    "directory": "packages/ui-vue"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./overrides": {
      "types": "./dist/overrides.d.ts",
      "import": "./dist/overrides.js"
    },
    "./states": {
      "types": "./dist/states.d.ts",
      "import": "./dist/states.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./targets": {
      "types": "./dist/targets.d.ts",
      "import": "./dist/targets.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/local-core-writer.mjs --packages ui-vue --operation build -- tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "watch": "node ../../scripts/local-core-writer.mjs --packages ui-vue --operation watch -- tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "peerDependencies": {
    "@peanut-admin/vue": "5.0.2",
    "element-plus": "^2.14.3",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@peanut-admin/vue": "workspace:*"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
